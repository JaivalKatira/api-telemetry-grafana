# Copy this file to ".env" and change the values.  (.env is in .gitignore, so it is never committed.)
#   Windows:     copy .env.example .env
#   Mac/Linux:   cp .env.example .env

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# How long (seconds) the API keeps a city's weather before asking Open-Meteo again
CACHE_TTL_SECONDS=600
